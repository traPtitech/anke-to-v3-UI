{
  "name": "anke-to-v3-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxi typecheck",
    "format": "prettier --write --ignore-path .gitignore \"**/*.{js,ts,vue,json,md}\"",
    "lint": "eslint --cache --cache-location .cache/eslint/.eslintcache --cache-strategy content .",
    "lint:fix": "eslint --fix .",
    "stylelint": "stylelint --cache --cache-location .cache/stylelint/.stylelintcache --cache-strategy content \"{assets,components,layouts,pages}/**/*.{css,scss,vue}\" \"app.vue\"",
    "stylelint:fix": "stylelint --fix \"{assets,components,layouts,pages}/**/*.{css,scss,vue}\" \"app.vue\"",
    "test": "vitest run",
    "openapi:anke-to": "openapi-typescript https://raw.githubusercontent.com/traPtitech/anke-to/main/docs/swagger/swagger.yaml --output ./composables/type-fetch/anke-to/openapi.ts"
  },
  "devDependencies": {
    "@nuxt/devtools": "3.4.2",
    "@nuxt/eslint-config": "1.17.0",
    "@nuxt/icon": "2.5.1",
    "@nuxt/test-utils": "4.1.0",
    "@pinia/nuxt": "1.0.2",
    "@primevue/nuxt-module": "4.5.5",
    "@vue/devtools-api": "8.2.1",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.11.0",
    "happy-dom": "20.11.6",
    "msw": "2.15.0",
    "nuxt": "4.5.2",
    "openapi-typescript": "7.13.0",
    "pinia": "4.0.3",
    "pinia-plugin-persistedstate": "4.7.1",
    "postcss-html": "2.0.0",
    "prettier": "3.9.6",
    "ress": "6.0.0",
    "sass": "1.103.1",
    "stylelint": "17.14.1",
    "stylelint-config-recess-order": "7.8.0",
    "stylelint-order": "8.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vue": "3.5.41",
    "vue-router": "5.2.0",
    "vue-tsc": "3.3.11"
  },
  "dependencies": {
    "@primeuix/themes": "2.0.3",
    "@primevue/forms": "4.5.5",
    "@traptitech/traq-markdown-it": "7.1.0",
    "openapi-fetch": "0.17.0",
    "primevue": "4.5.5",
    "smooth-dnd": "0.12.1",
    "vue3-smooth-dnd": "0.0.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
